{"number":112,"nameArabic":"الإخلاص","nameTransliterated":"Al-Ikhlas","nameTranslated":"The Sincerity","revelationPlace":"makkah","versesCount":4,"verses":[{"ayah":1,"verseKey":"112:1","textAr":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","transliteration":"Qul huwa Allahu ahadun","translations":[{"lang":"en","translator":"Saheeh International (via quranenc.com)","text":"Say, \"He is Allah, [who is] One"},{"lang":"ur","translator":"Fateh Muhammad Jalandhari (via quranenc.com)","text":"کہو، وہ اللہ ہے، یکتا"}]},{"ayah":2,"verseKey":"112:2","textAr":"ٱللَّهُ ٱلصَّمَدُ","transliteration":"Allahu alssamadu","translations":[{"lang":"en","translator":"Saheeh International (via quranenc.com)","text":"Allah, the Eternal Refuge"},{"lang":"ur","translator":"Fateh Muhammad Jalandhari (via quranenc.com)","text":"اللہ سب سے بے نیاز ہے اور سب اس کے محتاج ہیں"}]},{"ayah":3,"verseKey":"112:3","textAr":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","transliteration":"Lam yalid walam yooladu","translations":[{"lang":"en","translator":"Saheeh International (via quranenc.com)","text":"He neither begets nor is born"},{"lang":"ur","translator":"Fateh Muhammad Jalandhari (via quranenc.com)","text":"نہ اس کی کوئی اولاد ہے اور نہ وہ کسی کی اولاد"}]},{"ayah":4,"verseKey":"112:4","textAr":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","transliteration":"Walam yakun lahu kufuwan ahadun","translations":[{"lang":"en","translator":"Saheeh International (via quranenc.com)","text":"Nor is there to Him any equivalent"},{"lang":"ur","translator":"Fateh Muhammad Jalandhari (via quranenc.com)","text":"اور کوئی اس کا ہمسر نہیں ہے"}]}]}